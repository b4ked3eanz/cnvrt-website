# Working material, not part of the site. index.html references none of it and
# together it is ~400MB — an order of magnitude more than the site itself.
hero-video/
hero-options/
hud.png
Frame*.png

# OS / editor cruft
Thumbs.db
.DS_Store
desktop.ini

# Scratch from the headless-Chrome tooling in tools/. cprofile, cprofile2 and
# pprofile are Chrome user-data dirs — 150-220MB EACH, 566MB together, which is
# most of what this working tree weighs; dump-*.png are the baked map / mask /
# transmittance images written by the diagnostic evals; sweep-eval.js is
# generated by sweep.js on every run.
tools/cprofile/
tools/cprofile2/
tools/pprofile/
tools/dump-*.png
tools/sweep-eval.js

# Reference footage for the shader (PICKUP.md's table says what each clip is)
# and the screen recordings taken while tuning it. Same rule as the block at the
# top: index.html references none of it, it is ~19MB, and git history is
# forever. They stay on disk, they do not go in.
/*.mp4

# A recorded trace, written by tools/ev-probe.js through the server's /_save
# route so tools/ev-dash.js has something to load. Regenerated on every run.
tools/trace.json

# Generated by tools/ev-makeletter.js as a fixture for the dot matrix tool.
tools/_testletter.png
